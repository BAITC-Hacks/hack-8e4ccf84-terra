# Replace all placeholders before running Compose. Use an alphanumeric database password.
POSTGRES_PASSWORD=replace-with-strong-random-value
ADMIN_PASSWORD=replace-with-strong-random-value
ADMIN_API_TOKEN=replace-with-strong-random-value
SESSION_SECRET=replace-with-at-least-32-random-characters
JOB_TICK_SECRET=replace-with-strong-random-value
APP_PORT=3000
OPENAI_API_KEY=
OPENAI_MODEL=
AGENT_LLM_ENABLED=false
OPENAI_REASONING_EFFORT=medium
OPENAI_AGENTS_DISABLE_TRACING=1
AGENT_MAX_TURNS=8
AGENT_MAX_TOOL_EXECUTIONS=16
AGENT_LLM_TIMEOUT_MS=30000
AGENT_TOOL_TIMEOUT_MS=45000
AGENT_TICK_BUDGET_MS=60000
AGENT_LEASE_MS=90000
AGENT_HEARTBEAT_MS=15000
AGENT_MAX_OUTPUT_TOKENS=3000
JOB_DISPATCHER_INTERVAL_MS=1000
JOB_DISPATCHER_TICK_TIMEOUT_MS=70000
