# Replace all placeholders before running Compose. Use an alphanumeric database password.
POSTGRES_PASSWORD=replace-with-strong-random-value
ADMIN_PASSWORD=replace-with-strong-random-value
ADMIN_API_TOKEN=replace-with-strong-random-value
SESSION_SECRET=replace-with-at-least-32-random-characters
JOB_TICK_SECRET=replace-with-strong-random-value
APP_PORT=3000

# Optional industrial connector gateways. Credentials stay server-side.
ORACLE_CONNECTOR_GATEWAY_URL=https://oracle-gateway.example.internal
ORACLE_CONNECTOR_TOKEN=replace-with-strong-random-value
WINCC_CONNECTOR_GATEWAY_URL=https://wincc-gateway.example.internal
WINCC_CONNECTOR_TOKEN=replace-with-strong-random-value
